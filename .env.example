DATABASE_URL=postgres://postgres:postgres@localhost:5432/termpilot
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
DEEPSEEK_API_KEY=

# What2Reg @ UM (澳大選咩課) read-only MCP. Leave the client blank to run without reviews.
# Register the redirect URI on the What2Reg Clerk OAuth application. Do not put real secrets in Git.
WHAT2REG_CLIENT_ID=
WHAT2REG_CLIENT_SECRET=
WHAT2REG_REDIRECT_URI=http://localhost:3000/api/what2reg/callback
# Optional. Production must set this before tokens are stored. 32-byte base64, or any passphrase.
WHAT2REG_TOKEN_KEY=
# Optional overrides. Defaults match the published OAuth metadata (checked 2026-11-16).
WHAT2REG_MCP_URL=https://umeh.top/mcp
WHAT2REG_AUTHORIZATION_ENDPOINT=https://clerk.umeh.top/oauth/authorize
WHAT2REG_TOKEN_ENDPOINT=https://clerk.umeh.top/oauth/token
WHAT2REG_REVOCATION_ENDPOINT=https://clerk.umeh.top/oauth/token/revoke
WHAT2REG_SCOPE=umhelper:read offline_access
WHAT2REG_RESOURCE=https://umeh.top/mcp
